<!--
    Ícono simple de la app (un reloj/recordatorio) hecho como vector, para no depender
    de archivos de imagen PNG en varias densidades. Es suficiente para desarrollo y clase;
    para publicar la app en Play Store se recomienda generar un ícono adaptativo con
    Image Asset Studio (botón derecho en res -> New -> Image Asset).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo morado (color primario del tema claro) -->
    <path
        android:fillColor="#6750A4"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Círculo blanco que simula la esfera de un reloj -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,20 A34,34 0 1 1 53.9,20 Z" />

    <!-- Manecillas del reloj apuntando a un "check" de tarea cumplida -->
    <path
        android:fillColor="#6750A4"
        android:pathData="M50,34 h8 v22 h18 v8 h-26 Z" />
</vector>
